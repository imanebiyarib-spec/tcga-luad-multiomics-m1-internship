# ------------------------------------------------------------------------------
# Step 1: Load the files safely
# Using read_tsv prevents R from turning spaces in column names into dots
# ------------------------------------------------------------------------------
samples  <- read_tsv("sample_sheet.tsv", show_col_types = FALSE)
clinical <- read_tsv("clinical.tsv", show_col_types = FALSE)
exposure <- read_tsv("exposure.tsv", show_col_types = FALSE)
# ------------------------------------------------------------------------------
# Step 2: Standardize keys and merge
# ------------------------------------------------------------------------------
# Rename 'Case ID' in the sample sheet to match the other files, then merge.
master_metadata <- samples %>%
rename(case_submitter_id = `Case ID`) %>%
left_join(clinical, by = "case_submitter_id") %>%
left_join(exposure, by = "case_submitter_id")
