library(tidyverse)
# Load required libraries
library(dplyr)
library(ggplot2)
library(stringr)
# ------------------------------------------------------------------------------
# Step 1: Load the TSV files
# ------------------------------------------------------------------------------
samples  <- read.delim("sample_sheet.tsv", stringsAsFactors = FALSE)
clinical <- read.delim("clinical.tsv", stringsAsFactors = FALSE)
exposure <- read.delim("exposure.tsv", stringsAsFactors = FALSE)
View(samples)
# Replace spaces with underscores in the sample sheet column names (as you did)
colnames(samples) <- gsub(" ", "_", colnames(samples))
# ------------------------------------------------------------------------------
# Step 2: Standardize keys and merge
# ------------------------------------------------------------------------------
# Merge explicitly using the exact column names we discovered in debugging
master_metadata <- samples %>%
left_join(clinical, by = c("Case_ID" = "cases.submitter_id")) %>%
left_join(exposure, by = c("Case_ID" = "cases.submitter_id"))
# ------------------------------------------------------------------------------
# Step 2: Standardize keys and merge
# ------------------------------------------------------------------------------
# Merge explicitly using the exact column names we discovered in debugging
master_metadata <- samples %>%
left_join(clinical, by = c("Case.ID" = "cases.submitter_id")) %>%
left_join(exposure, by = c("Case.ID" = "cases.submitter_id"))
# CRITICAL: Remove accidental TCGA duplicates so we don't double-count patients
master_metadata <- master_metadata %>%
distinct(Sample_ID, .keep_all = TRUE)
View(master_metadata)
# CRITICAL: Remove accidental TCGA duplicates so we don't double-count patients
master_metadata <- master_metadata %>%
distinct(Sample.ID, .keep_all = TRUE)
View(master_metadata)
table(exposure$exposures.tobacco_smoking_status)
table(clinical$demographic.country_of_residence_at_enrollment)
table(clinical$demographic.gender)
# ------------------------------------------------------------------------------
# Step 3: Clean and categorize the variables for plotting
# ------------------------------------------------------------------------------
clean_metadata <- master_metadata %>%
mutate(
# 1. Condition: Classify based on the "Tissue_Type" column
Condition = case_when(
grepl("Normal", Tissue.Type, ignore.case = TRUE) ~ "Healthy",
grepl("Tumor", Tissue.Type, ignore.case = TRUE) ~ "Tumor",
TRUE ~ "Other"
),
# 2. Smoking Status: Clean the specific TCGA  codes
Smoking_Status = case_when(
exposures.tobacco_smoking_history == "Lifelong Non-Smoker" ~ "Non-Smoker",
exposures.tobacco_smoking_history == "Current Smoker" ~ "Smoker (Current)",
exposures.tobacco_smoking_history %in% c("Current Reformed Smoker for < or = 15 yrs",
"Current Reformed Smoker, Duration Not Specified",
"Current Reformed Smoker for > 15 yrs") ~ "Smoker (Reformed)",
TRUE ~ "Unknown/Not Reported"
),
# 3. Gender: Capitalize for cleaner plot labels, handle missing data
Gender = case_when(
is.na(demographic.gender) | demographic.gender == "'--'" ~ "Unknown",
TRUE ~ str_to_title(demographic.gender)
)
)
