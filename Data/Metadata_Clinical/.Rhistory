colnames(samples)
# ==============================================================================
# Step 2: Standardize keys and merge
# ==============================================================================
# We tell R explicitly: match "Case_ID" from samples to "cases.submitter_id" in the others.
master_metadata <- samples %>%
left_join(clinical, by = c("Case_ID" = "cases.submitter_id")) %>%
left_join(exposure, by = c("Case_ID" = "cases.submitter_id"))
# Remove duplicates (Note: 'Sample ID' is now 'Sample_ID' due to your gsub command)
master_metadata <- master_metadata %>%
distinct(Sample_ID, .keep_all = TRUE)
# ==============================================================================
# Step 3: Clean and categorize the variables for plotting
# ==============================================================================
clean_metadata <- master_metadata %>%
mutate(
# 1. Condition: Use 'Sample_Type' with the underscore
Condition = case_when(
grepl("Normal", Sample_Type, ignore.case = TRUE) ~ "Healthy",
grepl("Tumor", Sample_Type, ignore.case = TRUE) ~ "Tumor",
TRUE ~ "Other"
),
# 2. Smoking Status: Now we use the exact column name from your exposure file
Smoking_Status = case_when(
exposures.tobacco_smoking_history == "1" ~ "Non-Smoker",
exposures.tobacco_smoking_history %in% c("2", "3", "4", "5") ~ "Smoker (Current/Reformed)",
TRUE ~ "Unknown/Not Reported"
),
# 3. Gender: Capitalize for cleaner plot labels
Gender = str_to_title(demographic.gender) # Make sure this matches your clinical column name for gender!
)
View(master_metadata)
# Load required libraries
library(dplyr)
